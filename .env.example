# 把需要的项合并进 NoneBot 项目实际使用的 .env / .env.prod
WOWS_APPLICATION_ID="replace_with_your_wg_application_id"

# 输出：image = 图片卡片（需要 Chromium），text = 纯文字
WOWS_RENDER_MODE=image
# AI 插件调用时在图片下附带文字数据（默认 false，只发图片）
WOWS_AI_CAPTION=false
WOWS_RENDER_SCALE=1.5
# 可选：使用系统已有的 Chromium/Chrome，而不是 playwright 下载的浏览器
# WOWS_BROWSER_PATH="/usr/bin/chromium"

# 最近战绩快照
WOWS_POLL_MINUTES=10
WOWS_FAST_POLL_MINUTES=3
WOWS_TRACK_DAYS=14
WOWS_MAX_TRACKED=200
WOWS_RECORD_DAYS=30

# 其它
WOWS_MIN_BATTLES=50
WOWS_TIMEOUT_SECONDS=15
WOWS_CACHE_SECONDS=60
WOWS_COMMAND_PRIORITY=10

# NoneBot 全局设置（按需合并）
# COMMAND_START=["/"]
